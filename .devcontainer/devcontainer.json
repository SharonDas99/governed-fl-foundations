{
  "name": "BANA 690A Federated Learning Foundations",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "hostRequirements": { "cpus": 2 },
  "postCreateCommand": "pip install -r requirements.txt && echo 'Setup complete. Run: python labs/lab0_world.py'",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    },
    "codespaces": { "openFiles": ["README.md", "LAB_NOTES.md"] }
  }
}
